# ─────────────────────────────────────────────────────────────────────────────
# UNIFIX environment. Copy to .env for local dev, or paste the REQUIRED block
# into Render → Environment. The app reads .env on startup (override=False, so
# real host env vars always win). Every var here is read somewhere in the code;
# unset optional ones just disable that feature.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ REQUIRED IN PRODUCTION ═════════════════════════════════════════════════
# Without all four the app refuses to boot when APP_ENV=production.

APP_ENV=production

# Postgres connection string (Neon, Render Postgres, etc.). If unset the app
# falls back to an in-memory store that is NOT shared between workers — fine for
# tests, broken for a real deployment.
DATABASE_URL=postgresql://user:password@host:5432/unifix?sslmode=require

# Flask session signing key. >= 32 chars, random. Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT signing secret for the auth cookie. >= 32 chars, random, DIFFERENT from SECRET_KEY.
JWT_SECRET=

# First admin account, created once on first boot (app will NOT auto-make admin/0000
# in production). User is forced to change this PIN on first login.
INITIAL_ADMIN_USERNAME=campus.admin
INITIAL_ADMIN_PIN=change-me-now


# ═══ RUNTIME (host usually sets PORT for you) ═══════════════════════════════
PORT=5000
# FLASK_DEBUG=0            # never 1 in production


# ═══ AI CLASSIFICATION (optional — falls back to keyword heuristics if unset) ═
GROQ_API_KEY=
# GROQ_MODEL_TEXT=qwen/qwen3.6-27b
# GROQ_MODEL_VISION=qwen/qwen3.6-27b


# ═══ EMAIL ALERTS (optional — no email sent if unset) ══════════════════════
RESEND_API_KEY=
# RESEND_FROM=UNIFIX <onboarding@resend.dev>
ADMIN_ALERT_EMAIL=

# Public contact address shown on /privacy and /get. Defaults to unifix@glbitm.ac.in
PRIVACY_CONTACT_EMAIL=


# ═══ EVIDENCE PHOTO STORAGE (optional) ═════════════════════════════════════
# If none of these are set, photos are stored inline as base64 in the DB.
# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://media.example.com
# --- or AWS S3 ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=
# --- or local disk (dev) ---
# LOCAL_STORAGE_PATH=static/uploads

# IMAGEKIT_PRIVATE_KEY=       # only if using ImageKit transforms
# AREAPULSE_URL=              # external AreaPulse integration, if any


# ═══ FIRESTORE FALLBACK (optional — used only if Postgres is unreachable) ═══
# Provide ONE of these forms:
# FIREBASE_KEY_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS_B64=<base64 of the service-account JSON>
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceaccount.json
# ALLOW_FIRESTORE_IN_DEV=1    # opt in to Firestore outside production


# ═══ ANDROID APK DISTRIBUTION (the /get page) ═════════════════════════════
# Where the signed APK lives. Default: <repo>/dist/unifix.apk
# On Render, either commit dist/unifix.apk or attach a disk and point here.
# APK_PATH=/var/data/unifix.apk
APK_VERSION=1.0.0

# TWA verification for /.well-known/assetlinks.json (set once the APK is built):
# TWA_PACKAGE_NAME=in.ac.glbitm.unifix
# TWA_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...,11:22:33:...


# ═══ DEMO DATA (leave unset for production) ═══════════════════════════════
# SEED_DEMO=1
# ALLOW_PROD_DEMO_SEED=1      # DANGER: seeds sample data into a prod DB
